# Main language model provider: openai, ollama, groq, openrouter, cerebras, gemini, or deepseek.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MODEL_FAST=gpt-4o-mini
MODEL_REASONING=gpt-4o

# Ollama settings, used when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_FAST=
OLLAMA_MODEL_REASONING=

# Safety, PubMed retrieval, and local persistence.
ENABLE_SAFETY_GUARD=true
ENABLE_ADVANCED_RAG=true
ENABLE_DYNAMIC_KB_RAG=true
ENABLE_KNOWLEDGE_AGENT=true
DB_PATH=medical_ai.db
NCBI_EMAIL=
NCBI_API_KEY=
OPENFDA_API_KEY=

# Robot voice. The robot can also use the OpenAI voice provider.
TTS_PROVIDER=edge

# Demo-grade clinician gate. Set a private value for local use.
DOCTOR_TOKEN=
